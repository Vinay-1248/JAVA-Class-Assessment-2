public class CountDividingDigits {

    public static int countDigits(int n) {
        int count = 0;
        
        // Use a temporary variable to extract digits 
        // Math.abs handles negative numbers correctly
        int temp = Math.abs(n); 

        while (temp > 0) {
            int digit = temp % 10; // Extract the last digit
            
            // A digit divides the number if it's not 0 and the remainder is 0
            if (digit != 0 && n % digit == 0) {
                count++;
            }
            
            temp /= 10; // Remove the last digit
        }

        return count;
    }

    public static void main(String[] args) {
        int num1 = 1248;
        int num2 = 1012; 
        int num3 = -24;
        
        System.out.println("Dividing digits in " + num1 + ": " + countDigits(num1)); 
        // 1, 2, 4, 8 all divide 1248 -> Output: 4
        
        System.out.println("Dividing digits in " + num2 + ": " + countDigits(num2)); 
        // 1, 1, 2 divide 1012 (0 is skipped) -> Output: 3
        
        System.out.println("Dividing digits in " + num3 + ": " + countDigits(num3)); 
        // 2, 4 both divide -24 -> Output: 2
    }
}
